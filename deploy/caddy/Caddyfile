# The one public entrance (modelled on MyBiz's deploy/caddy/Caddyfile). APP_DOMAIN is e.g. hr.tysoftltd.com:
#   https://<domain>             the web app; /api/* -> the API
#   https://<anything>.<domain>  redirected to https://<domain>: Keycloak can't take wildcard addresses, so sign-in only
#                                works at the one registered by setup.sh
# Sign-in is MyBiz's Keycloak (AUTH_URL in docker-compose.prod.yml), not served here.
# "auth" and "api" are reserved company codes (TyHr.Domain/Tenants/TenantSlug.cs), so no company can take them.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN}, *.{$APP_DOMAIN} {
	# One wildcard certificate for every company, through Cloudflare's DNS.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@elsewhere not host {$APP_DOMAIN}
	redir @elsewhere https://{$APP_DOMAIN}{uri}

	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}
